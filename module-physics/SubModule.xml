<?xml version="1.0" encoding="utf-8"?>
<Module>
  <Name value="Bannerlord VR - Enemy Physics" />
  <Id value="BannerlordVR.Physics" />
  <Version value="v0.1.0" />
  <SingleplayerModule value="true" />
  <MultiplayerModule value="false" />

  <!-- Loads after the official BannerlordVR release, which it reads and
       never replaces. -->
  <DependedModules>
    <DependedModule Id="Native" />
    <DependedModule Id="Bannerlord.Harmony" />
    <DependedModule Id="BannerlordVR" />
  </DependedModules>

  <!-- Loads after the combat and framework mods it can meet (BLSE and the
       launcher read this order; none is required). -->
  <DependedModuleMetadatas>
    <DependedModuleMetadata id="Bannerlord.ButterLib" order="LoadBeforeThis" optional="true" />
    <DependedModuleMetadata id="Bannerlord.UIExtenderEx" order="LoadBeforeThis" optional="true" />
    <DependedModuleMetadata id="Bannerlord.MBOptionScreen" order="LoadBeforeThis" optional="true" />
    <DependedModuleMetadata id="RBM" order="LoadBeforeThis" optional="true" />
  </DependedModuleMetadatas>

  <SubModules>
    <SubModule>
      <Name value="BannerlordVR.Physics" />
      <DLLName value="BannerlordVR.Physics.dll" />
      <SubModuleClassType value="BannerlordVR.Physics.PhysicsSubModule" />
      <Tags>
        <Tag key="DedicatedServerType" value="none" />
        <Tag key="IsNoRenderModeElement" value="false" />
      </Tags>
    </SubModule>
  </SubModules>

  <!-- bvr_severed_head: the meshless head armour a beheaded agent wears.
       No game type list: loaded for every game type, so total conversions
       with their own campaign type have it too. -->
  <Xmls>
    <XmlNode>
      <XmlName id="Items" path="bvr_items" />
    </XmlNode>
  </Xmls>
</Module>
