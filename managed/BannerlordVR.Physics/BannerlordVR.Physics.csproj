<Project Sdk="Microsoft.NET.Sdk">

  <!-- =====================================================================
       BannerlordVR.Physics - Blade & Sorcery style enemy physics, shipped as
       its own module beside an unmodified BannerlordVR release. Compiles
       against the installed release's BannerlordVR.dll (public VR state) and
       never copies it.
       ===================================================================== -->

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyName>BannerlordVR.Physics</AssemblyName>
    <RootNamespace>BannerlordVR.Physics</RootNamespace>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\build\physics-managed\</OutputPath>

    <BannerlordDir Condition="'$(BannerlordDir)' == ''">D:\SteamLibrary\steamapps\common\Mount &amp; Blade II Bannerlord</BannerlordDir>
    <GameBinDir>$(BannerlordDir)\bin\Win64_Shipping_Client</GameBinDir>
    <NativeModuleBinDir>$(BannerlordDir)\Modules\Native\bin\Win64_Shipping_Client</NativeModuleBinDir>
    <VrModuleBinDir>$(BannerlordDir)\Modules\BannerlordVR\bin\Win64_Shipping_Client</VrModuleBinDir>
    <ModuleDeployDir>$(BannerlordDir)\Modules\BannerlordVR.Physics</ModuleDeployDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <!-- Compile-time only; Bannerlord.Harmony supplies 0Harmony.dll at runtime. -->
    <PackageReference Include="Lib.Harmony" Version="2.2.2" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <GameReference Include="TaleWorlds.MountAndBlade" />
    <GameReference Include="TaleWorlds.Engine" />
    <GameReference Include="TaleWorlds.Library" />
    <GameReference Include="TaleWorlds.Core" />
    <GameReference Include="TaleWorlds.DotNet" />
    <GameReference Include="TaleWorlds.ObjectSystem" />
    <GameReference Include="TaleWorlds.ScreenSystem" />
    <NativeModuleReference Include="TaleWorlds.MountAndBlade.View" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="@(GameReference)">
      <HintPath>$(GameBinDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="@(NativeModuleReference)">
      <HintPath>$(NativeModuleBinDir)\%(Identity).dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- The installed BannerlordVR release, used as is. -->
    <Reference Include="BannerlordVR">
      <HintPath>$(VrModuleBinDir)\BannerlordVR.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <Target Name="VerifyGamePaths" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(GameBinDir)\TaleWorlds.Engine.dll')"
           Text="Bannerlord not found at '$(BannerlordDir)'. Pass -p:BannerlordDir=&quot;...&quot;." />
    <Error Condition="!Exists('$(VrModuleBinDir)\BannerlordVR.dll')"
           Text="BannerlordVR is not installed at '$(VrModuleBinDir)'. Install the official release first." />
  </Target>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(SkipDeploy)' != 'true'">
    <ItemGroup>
      <DeployBin Include="$(OutputPath)BannerlordVR.Physics.dll" />
      <DeployBin Include="$(OutputPath)BannerlordVR.Physics.pdb" Condition="Exists('$(OutputPath)BannerlordVR.Physics.pdb')" />
      <DeployNative Include="$(MSBuildThisFileDirectory)..\..\build\physics-native\BannerlordVR.Physics.Native.dll" />
      <DeployModule Include="$(MSBuildThisFileDirectory)..\..\module-physics\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(DeployBin)" DestinationFolder="$(ModuleDeployDir)\bin\Win64_Shipping_Client\" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(DeployNative)" DestinationFolder="$(ModuleDeployDir)\bin\Win64_Shipping_Client\" SkipUnchangedFiles="true" Condition="Exists('%(FullPath)')" />
    <Copy SourceFiles="@(DeployModule)" DestinationFiles="@(DeployModule->'$(ModuleDeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Message Importance="high" Text="BannerlordVR.Physics deployed -> $(ModuleDeployDir)" />
  </Target>

</Project>
